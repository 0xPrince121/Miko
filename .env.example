# ------------------------------------------------------------------
# Miko — environment configuration
# Copy this file to `.env` and fill in your values.
# ------------------------------------------------------------------

# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret

# Public URL of the dashboard (also used as the OAuth2 redirect base)
DASHBOARD_URL=http://localhost:3000

# Exact Discord OAuth2 redirect URI — must match the "Redirects" entry in
# Discord Developer Portal → OAuth2 → General. Leave DASHBOARD_URL-based
# default unless you use a custom domain.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord

# Secret used to sign dashboard session cookies (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Secret shared between the dashboard and the bot's internal HTTP API
BOT_API_KEY=change-me-to-another-random-secret

# Where the bot's internal API listens (called by the dashboard to deploy panels)
BOT_API_URL=http://localhost:3001
BOT_API_PORT=3001

# SQLite database. The path is relative to the project root unless absolute.
# e.g. postgres URL is also accepted later; SQLite is the default.
DATABASE_URL=file:data/miko.db